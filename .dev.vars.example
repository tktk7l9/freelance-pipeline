# For local development. Copy to `.dev.vars` (already gitignored).
# With Keyway: keyway pull -e development -f .dev.vars -y
#
# There is no Cloudflare Access locally, so only when ENVIRONMENT=development is
# DEV_IDENTITY_EMAIL treated as the authenticated user. Always disabled in production.

ENVIRONMENT=development
DEV_IDENTITY_EMAIL=owner@example.com
ACCESS_ALLOWED_EMAILS=owner@example.com

# Values used only in production (may be empty locally)
ACCESS_TEAM_DOMAIN=
ACCESS_POLICY_AUD=
