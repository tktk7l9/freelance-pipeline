/**
 * freelance-pipeline — Cloudflare Workers config
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freelance-pipeline",
  // Upper bound supported by @cloudflare/vitest-pool-workers@0.22 (measured in sumai-log)
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freelance-pipeline",
      "database_id": "69b86da8-e4d0-42e0-8dad-912dbfd497b5",
      "migrations_dir": "drizzle/migrations",
    },
  ],

  /**
   * Default to production so a missing setting always falls to "deny".
   * ACCESS_TEAM_DOMAIN / ACCESS_POLICY_AUD are the production Access app values (not secret; the AUD is a public identifier).
   * ACCESS_ALLOWED_EMAILS is a secret (`wrangler secret put`). Never write it here.
   */
  "vars": {
    "ENVIRONMENT": "production",
    // Values of the production Access app (already created via the Zero Trust API). The AUD is a public identifier.
    "ACCESS_TEAM_DOMAIN": "https://odd-bush-1f0d.cloudflareaccess.com",
    "ACCESS_POLICY_AUD": "5dbf9e8d4d6d8a05a59a5b563a5881f0eff33dcb3fb19944d92e0599fa9cde69", // gitleaks:allow (a public identifier, not a secret: the Access app AUD tag)
  },
}
