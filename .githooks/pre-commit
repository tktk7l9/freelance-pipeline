#!/bin/sh
# Checks that no real data is mixed into the commit.
#
# Writing it in AGENTS.md alone does not enforce it. Do not rely on human attention.
#
# Only the index contents are checked (what actually goes into the commit). Takes about 0.2s.
# If you really must get through, use git commit --no-verify.
#
# This hook lives in .githooks/ and is committed. It is enabled by the prepare script
# that runs on npm install (it points core.hooksPath here).

node scripts/check-pii.mjs --staged || {
  echo ''
  echo 'コミットを中止しました。実データは *.local.json 経由でのみ入れます。'
  echo '（意図して通す場合のみ: git commit --no-verify）'
  exit 1
}
