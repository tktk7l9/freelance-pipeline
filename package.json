{
  "name": "freelance-pipeline",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "test": "vitest run && npm run test:ui && vitest run --config vitest.workers.config.ts && npm run test:scripts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:ui:coverage": "vitest run --config vitest.ui.config.ts --coverage",
    "test:server": "vitest run --config vitest.workers.config.ts",
    "test:scripts": "node --experimental-strip-types --test scripts/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pii": "node scripts/check-pii.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply freelance-pipeline --local",
    "db:migrate:remote": "wrangler d1 migrations apply freelance-pipeline --remote",
    "db:export": "wrangler d1 export freelance-pipeline --remote --output backups/freelance-pipeline-$(date +%Y%m%d).sql",
    "add-case": "node --experimental-strip-types scripts/add-case.ts",
    "import:history": "node --experimental-strip-types scripts/import-history.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@mantine/core": "^9.7.2",
    "@mantine/dates": "^9.7.2",
    "@mantine/form": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@mantine/schedule": "^9.7.2",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-plugin": "^1.168.43",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.45",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261012.1": true
  }
}
